# Copy to .env.local for local development.
# Add the same keys in Vercel: Project Settings -> Environment Variables.

# Canonical origin. Used for metadata, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://washworldcoinlaundry.ca

# Contact form delivery (https://resend.com/api-keys).
# Without this key /api/contact returns a clear error instead of dropping mail.
RESEND_API_KEY=

# Optional. Defaults to order@curbsidelaundry.ca
CONTACT_TO_EMAIL=

# Optional. Defaults to "Washworld Website <onboarding@resend.dev>".
# Replace with a verified sender on your own domain before launch.
CONTACT_FROM=
